# Copy this file to .env and fill it in. Never upload .env or send it to anyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram group commands: Telegram user IDs allowed to place orders and ask for analysis, comma-separated
# (anyone not on the list who messages the bot is told their own ID)
TELEGRAM_ALLOWED_USERS=
# Claude analysis (get a key at console.anthropic.com)
ANTHROPIC_API_KEY=
# Qwen analysis (get a key in Alibaba Cloud Bailian); set LLM_PROVIDER=qwen to ask Qwen first
DASHSCOPE_API_KEY=
LLM_PROVIDER=
